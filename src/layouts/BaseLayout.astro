---
/**
 * ============================================================
 *  BaseLayout — estructura común de todas las páginas
 * ============================================================
 *
 *  Renderiza en build time (HTML estático): head con SEO/OG, favicon,
 *  manifest PWA, fondo de la app y footer con el almanaque.
 *  Todo lo interactivo se hidrata dentro de <slot /> (islas React).
 *
 *  Estilos: Tailwind v4 (global.css provee tokens y utilidades custom;
 *  el resto son utilidades aplicadas directo en el markup).
 */
import '../styles/global.css';
import Almanac from '../components/Almanac.jsx';

interface Props {
  title?: string;
  description?: string;
}

const SITE_URL = 'https://radiosarg.netlify.app';

const {
  title = 'Radios Argentinas',
  description = 'Escuchá en vivo las principales radios AM y FM de Argentina. Reproductor simple, liviano y al instante.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <!-- Color de la barra del navegador en móviles -->
    <meta name="theme-color" content="#0b0b0b" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph: vista previa al compartir en redes sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:image" content={`${SITE_URL}/icons/icon-512.png`} />
    <meta property="og:locale" content="es_AR" />

    <!-- Favicon + íconos PWA -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

    <!-- PWA: @vite-pwa/astro genera ambos archivos durante el build pero no
         los inyecta en el HTML de Astro, por eso se referencian acá. -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <script is:inline src="/registerSW.js" defer></script>

    <title>{title}</title>
  </head>

  <!-- bg-app: utilidad custom (base azul-negra + glow radial celeste).
       El body es columna flex: main crece (flex-1) y el footer queda abajo. -->
  <body class="bg-app flex min-h-svh flex-col font-sans antialiased text-fg">
    <slot />

    <footer class="flex flex-col items-center gap-2 px-4 pt-6 pb-8 text-center">
      <!-- Almanaque: fecha + clima automático (por IP, sin prompts).
           client:idle: se hidrata cuando el navegador está libre,
           después del player que es lo crítico. -->
      <Almanac client:idle />
      <p class="text-[0.8rem] text-white/40">Siempre a tu alcance</p>
    </footer>
  </body>
</html>
